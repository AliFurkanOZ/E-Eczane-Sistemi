# ==============================================================================
# E-Eczane Backend - Ortam Değişkenleri Şablonu (.env.example)
# ==============================================================================
# Bu dosyayı '.env' olarak kopyalayın ve kendi gizli bilgilerinizi doldurun:
#   Windows: copy .env.example .env
#   Linux/Mac: cp .env.example .env
# DİKKAT: .env dosyasını ASLA Git'e veya GitHub'a göndermeyin!
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Veritabanı (PostgreSQL - İlişkisel Veriler)
# ------------------------------------------------------------------------------
# Format: postgresql://[kullanıcı]:[şifre]@[host]:[port]/[veritabanı_adı]
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/eczane_db

# ------------------------------------------------------------------------------
# 2. Güvenlik & JWT (JSON Web Token)
# ------------------------------------------------------------------------------
# Güçlü bir SECRET_KEY üretmek için terminalde çalıştırın:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-this-to-a-very-secure-random-32-byte-hex-string-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ------------------------------------------------------------------------------
# 3. CORS & Ortam Ayarları
# ------------------------------------------------------------------------------
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:3000
ENVIRONMENT=development
FRONTEND_URL=http://localhost:5173

# ------------------------------------------------------------------------------
# 4. E-Posta Servisi (SMTP - Şifre Sıfırlama ve Sipariş Bildirimleri)
# ------------------------------------------------------------------------------
# Gmail kullanıyorsanız "Google Hesabı > Güvenlik > 2 Adımlı Doğrulama > Uygulama Şifreleri"
# bölümünden 16 haneli bir Uygulama Şifresi almalısınız.
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=ornek_email@gmail.com
MAIL_PASSWORD=ornek_uygulama_sifresi
MAIL_FROM=noreply@e-eczane.com
MAIL_FROM_NAME=E-Eczane Sistemi

# ------------------------------------------------------------------------------
# 5. AWS DynamoDB (NoSQL - Bildirimler, Denetim Logları)
# ------------------------------------------------------------------------------
# AWS IAM Console üzerinden DynamoDB yetkilerine sahip bir kullanıcı oluşturun.
AWS_ACCESS_KEY_ID=AKIA_ORNEK_ACCESS_KEY_ID
AWS_SECRET_ACCESS_KEY=ornek_aws_secret_access_key
AWS_REGION=eu-central-1
DYNAMODB_TABLE_PREFIX=e_eczane_
=======
